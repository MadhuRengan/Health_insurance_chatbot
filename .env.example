
# Copy this file to .env for local development and replace the placeholder.
# Never commit the real .env file.
GOOGLE_API_KEY=replace_with_your_google_gemini_api_key
 
# Stable Gemini model currently used by the application.
GOOGLE_MODEL=gemini-3.5-flash
 
# Hugging Face embedding model used to build the FAISS index.
EMBEDDING_MODEL=all-MiniLM-L6-v2
